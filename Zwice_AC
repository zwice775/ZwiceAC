name: Build
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -q ZwiceAC-source.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
      - run: mvn -B clean package
        working-directory: ZwiceAC
      - uses: actions/upload-artifact@v4
        with:
          name: ZwiceAC
          path: ZwiceAC/target/ZwiceAC-1.0.0.jar
